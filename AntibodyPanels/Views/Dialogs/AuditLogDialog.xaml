<Window x:Class="AntibodyPanels.Views.Dialogs.AuditLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:AntibodyPanels.Help"
        help:Help.Topic="audit-log"
        Title="Audit log" Height="520" Width="960"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Append-only record of clinical actions. Events are never edited or deleted."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox x:Name="FindBox" VerticalAlignment="Center"
                     ToolTip="Filter by accession, action, Windows login, record type, or reason"
                     TextChanged="FindChanged"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Help" Width="84" Margin="0,0,8,0"
                    Command="{x:Static help:HelpCommands.ShowContext}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    ToolTip="Open help for this section (F1)"/>
            <Button Content="Export CSV..." Width="120" Margin="0,0,8,0" Click="ExportClick"/>
            <Button Content="Close" Width="84" IsCancel="True" IsDefault="True"/>
        </StackPanel>
        <DataGrid x:Name="EventsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="UTC" Binding="{Binding OccurredAtUtc}" Width="160"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="100"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140"/>
                <DataGridTextColumn Header="Type" Binding="{Binding EntityType}" Width="80"/>
                <DataGridTextColumn Header="Entity" Binding="{Binding EntityId}" Width="120"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
