<Window x:Class="HemoIQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HemoIQ.Views"
        Title="HemoIQ"
        Height="800" Width="1280" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCurrentCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshAllCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewItemCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Save" Command="{Binding SaveCurrentCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Refresh All" Command="{Binding RefreshAllCommand}" InputGestureText="Ctrl+R"/>
                <MenuItem Header="_New Item" Command="{Binding NewItemCommand}" InputGestureText="Ctrl+N"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Preferences..." Command="{Binding ShowSettingsCommand}"/>
                <MenuItem Header="_Purge Database..." Command="{Binding ShowPurgeDatabaseCommand}"
                          ToolTip="Remove old specimens to reclaim database space"/>
                <MenuItem Header="_Open Archive..." Command="{Binding ShowOpenArchiveCommand}"
                          ToolTip="Read or restore a previously saved specimen archive"/>
                <MenuItem Header="_Audit Log..." Command="{Binding ShowAuditLogCommand}"
                          ToolTip="View the append-only clinical audit trail"/>
                <Separator/>
                <MenuItem Header="E_xport Lab Configuration..." Command="{Binding ExportConfigurationCommand}"
                          ToolTip="Save the rules and laboratory-wide Preferences together, so another workstation reaches the same rule-outs"/>
                <MenuItem Header="_Import Lab Configuration..." Command="{Binding ImportConfigurationCommand}"
                          ToolTip="Preview a configuration file's rules and Preferences, then apply them together in one step"/>
                <Separator/>
                <MenuItem Header="Load _Demo Data" Command="{Binding LoadDemoDataCommand}"
                          ToolTip="Seeds seven real-world scenarios for testing"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_User Manual" Command="{Binding ShowManualCommand}"/>
                <MenuItem Header="_Topics" x:Name="HelpTopicsMenu"/>
                <Separator/>
                <MenuItem Header="Keyboard _Shortcuts" Command="{Binding ShowShortcutsCommand}"/>
                <Separator/>
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right" ToolTip="{Binding SessionDetail}">
                <Border Padding="6,1" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SessionViewOnly}" Value="True">
                                    <Setter Property="Background" Value="#FFF3CD"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SessionText}"/>
                </Border>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Margin="4,0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Tab control -->
        <TabControl x:Name="MainTabControl" SelectedIndex="{Binding SelectedTabIndex}"
                    SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Worklist">
                <views:WorklistView DataContext="{Binding WorklistVM}"/>
            </TabItem>
            <TabItem Header="Specimens">
                <views:SpecimensView DataContext="{Binding SpecimensVM}"/>
            </TabItem>
            <TabItem Header="Panels">
                <views:PanelsView DataContext="{Binding PanelsVM}"/>
            </TabItem>
            <TabItem Header="Reactions">
                <views:ReactionsView DataContext="{Binding ReactionsVM}"/>
            </TabItem>
            <TabItem Header="Analysis">
                <views:AnalysisView DataContext="{Binding AnalysisVM}"/>
            </TabItem>
            <TabItem Header="Reports">
                <views:ReportsView DataContext="{Binding ReportsVM}"/>
            </TabItem>
            <TabItem Header="Analytics">
                <views:AnalyticsView DataContext="{Binding AnalyticsVM}"/>
            </TabItem>
            <TabItem Header="Search">
                <views:SearchView DataContext="{Binding SearchVM}"/>
            </TabItem>
            <TabItem Header="Rules">
                <views:RulesView DataContext="{Binding RulesVM}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
